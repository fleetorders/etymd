dist/
build/
coverage/
*.log
.DS_Store
.env
.env.*
!.env.example
.etymd/cache/
# Local-only map from a manifest entry's name to its directory (older two-file manifest format).
sources.local.json
# Fleet sweep delta baselines are local-only (the README tells manifest repos the same).
*.fleet.json
# Machine-local notes: never tracked, so machine and account detail has a home outside the repo.
*.local.md

# Machine-local companion hooks and scratch; never tracked. Root-anchored so a nested `local/`
# stays trackable. Expendable by design: `git clean -fdx` and a fresh clone both drop it.
/local/
